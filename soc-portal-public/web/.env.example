# Variables SOLO para desarrollo local (npm run dev / pruebas e2e).
# El frontend NO contiene secretos: toda la autenticación la hace soc-bridge con cookie HttpOnly.
# Cualquier variable VITE_* acaba en el JavaScript público; no pongas aquí claves ni contraseñas.

# Backend al que Vite reenvía /portal/api, /portal/auth, /portal/data y /feeds en desarrollo
VITE_API_PROXY=http://127.0.0.1:8088

# Pruebas e2e (Playwright) — no se usan en el build
# E2E_BASE_URL=http://localhost:8088     # portal ya desplegado; si falta se arranca npm run dev
# E2E_USER=e2e                           # usuario analyst SIN MFA, solo para pruebas
# E2E_PASS=
# PW_CHROMIUM=/ruta/a/chrome             # Chromium ya instalado (opcional)
