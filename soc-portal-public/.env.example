# =====================================================================
#  Portal SOC — Wiki.js + Wazuh + MISP + Shuffle (SOAR)
#  Copia este archivo a .env y cambia TODOS los valores CAMBIAR_*
#  Nunca subas el archivo .env a un repositorio.
# =====================================================================

# Servidor del PORTAL SOC (Wiki.js + MISP + Shuffle + soc-bridge)
HOST_IP=10.0.0.10
# Servidor WAZUH existente (separado)
WAZUH_HOST=10.0.0.20

# ---------- Wiki.js ----------
WIKI_DB_PASSWORD=CAMBIAR_wiki_db
WIKI_URL=http://wikijs:3000
# Token creado en Wiki.js > Administración > API Access (grupo con permisos write:pages)
WIKI_API_KEY=CAMBIAR_token_wikijs
WIKI_LOCALE=es

# ---------- MISP ----------
MISP_BASE_URL=https://10.0.0.10:8443
MISP_ADMIN_EMAIL=admin@acme.example
MISP_ADMIN_PASSWORD=CAMBIAR_misp_admin
MISP_DB_PASSWORD=CAMBIAR_misp_db
MISP_DB_ROOT_PASSWORD=CAMBIAR_misp_root
# Contraseña de Redis de MISP (MISP 2.5+ la exige):  openssl rand -hex 16
MISP_REDIS_PASSWORD=CAMBIAR_misp_redis
# Clave de AUTOMATIZACIÓN de un usuario de solo lectura (MISP > Administration > Auth keys)
MISP_API_KEY=CAMBIAR_misp_key
MISP_VERIFY_TLS=false
# Clave para que el módulo de IoC del portal CREE eventos en MISP (usuario con rol "User" o "Org Admin",
# no la de solo lectura). Si se deja vacía, se intenta con MISP_API_KEY.
MISP_WRITE_API_KEY=

# ---------- Shuffle (SOAR) ----------
# Versión oficial fijada (repositorio + imágenes). Revisar notas de versión antes de cambiarla.
SHUFFLE_REF=v2.3.0
SHUFFLE_IMAGE_TAG=2.3.0
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo (requisito de OpenSearch)
SHUFFLE_OPENSEARCH_PASSWORD=CAMBIAR_Shuffle#2026
# Cifra las credenciales de apps guardadas en Shuffle:  openssl rand -hex 32
# NO cambiar después de la instalación (se perderían las credenciales guardadas)
SHUFFLE_ENCRYPTION_MODIFIER=CAMBIAR_hex_64
# Memoria de OpenSearch (≈50 % de la RAM libre del servidor)
SHUFFLE_OPENSEARCH_HEAP=2g
SHUFFLE_URL=http://10.0.0.10:3001
# Shuffle > Settings > API key (para soc-bridge)
SHUFFLE_API_KEY=CAMBIAR_shuffle_key

# ---------- Wazuh (servidor remoto existente) ----------
WAZUH_DASHBOARD_URL=https://10.0.0.20
WAZUH_API_URL=https://10.0.0.20:55000
# Usuario API de SOLO LECTURA (crear con wazuh/crear_usuario_api_lectura.py)
WAZUH_API_USER=soc-bridge
WAZUH_API_PASSWORD=CAMBIAR_wazuh_api
# Si el indexer está en otro nodo, pon su IP aquí
WAZUH_INDEXER_URL=https://10.0.0.20:9200
# Usuario interno del indexer con lectura sobre wazuh-alerts-* (README §4.4)
WAZUH_INDEXER_USER=soc-bridge
WAZUH_INDEXER_PASSWORD=CAMBIAR_wazuh_indexer
WAZUH_VERIFY_TLS=false

# ---------- Puente SOC (soc-bridge) ----------
# Cada cuántos segundos se actualiza la página SOC/Estado en la Wiki
SYNC_INTERVAL=300
# Portal web http://HOST_IP:8088/portal/  (acceso con usuario/contraseña)
# Solo se usa la PRIMERA vez para crear las cuentas locales (el primero será Administrador).
# Después los usuarios se gestionan en el portal → menú de usuario → «Usuarios y accesos».
# Si se deja vacío, se crea «admin» con una contraseña temporal que aparece en:  docker logs soc-bridge
PORTAL_USERS=admin:CAMBIAR_clave1,analista2:CAMBIAR_clave2
# La Wiki ya no es necesaria; pon true solo si quieres seguir publicando /soc/status en Wiki.js
WIKI_SYNC=false
PORTAL_USER=soc
PORTAL_PASSWORD=CAMBIAR_portal
WIKI_PUBLIC_URL=http://10.0.0.10:3000
# Token para Shuffle: crea incidentes en el portal con la cabecera X-API-Key (openssl rand -hex 24)
BRIDGE_TOKEN=CAMBIAR_token_bridge

# ---------- Motor de inteligencia (IoC) ----------
# Abrir incidente automático cuando un IoC nuevo con riesgo >= este valor aparece en Wazuh (0 = no)
INTEL_AUTO_INCIDENT_SCORE=0
# Tamaño máximo de archivo subido (MB) y de IoC por fuente
INTEL_UPLOAD_MAX_MB=2048
INTEL_MAX_PER_SOURCE=10000000
# Enriquecimiento externo (opcional, solo al analizar un indicador; caché de 24 h)
ABUSEIPDB_KEY=
VT_API_KEY=
OTX_API_KEY=
# Clave gratuita de abuse.ch (ThreatFox / URLhaus / MalwareBazaar): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# ---------- Herramientas (repositorio interno) ----------
# Opcional: token de GitHub de solo lectura para repositorios privados o para no topar el límite de 60 consultas/hora
GITHUB_TOKEN=
TOOLS_MAX_FILE_MB=50

# ---------- Login del portal ----------
# Roles que deben usar MFA (admin, analyst, viewer separados por comas; vacío = opcional para todos)
AUTH_REQUIRE_MFA=admin
# Intentos fallidos antes de bloquear la cuenta (0 = no bloquear; SOLO en desarrollo)
AUTH_MAX_FAILS=5
AUTH_LOCK_MIN=15
# Fallos desde una misma IP en 10 min antes de bloquearla (0 = no bloquear; SOLO en desarrollo)
AUTH_IP_MAX_FAILS=20
AUTH_IDLE_MIN=30
AUTH_MAX_HOURS=12
AUTH_LOG_DAYS=365
# true cuando el portal se publique por HTTPS (cookie solo por canal cifrado)
AUTH_COOKIE_SECURE=false
# Desde v14 el contenedor soc-web (nginx) va delante: docker-compose.yml ya fija AUTH_TRUST_PROXY=true
# para soc-bridge (el bridge no se publica al exterior). Este valor solo aplica si arrancas el bridge solo.
AUTH_TRUST_PROXY=false

# ---------- Active Directory (LDAP) ----------
LDAP_ENABLED=false
# ldaps://dc01.acme.local:636 (recomendado) o ldap://dc01.acme.local con LDAP_STARTTLS=true
LDAP_URL=ldaps://CAMBIAR_dc01.acme.local
LDAP_UPN_SUFFIX=acme.local
LDAP_BASE_DN=DC=acme,DC=local
LDAP_STARTTLS=false
LDAP_VERIFY_TLS=false
LDAP_TIMEOUT=8
# DN completos de los grupos del SOC (también valen grupos anidados). El primero que coincida da el rol.
LDAP_GROUP_ADMIN=CN=SOC-Admins,OU=Grupos,DC=acme,DC=local
LDAP_GROUP_ANALYST=CN=SOC-Analistas,OU=Grupos,DC=acme,DC=local
LDAP_GROUP_VIEWER=CN=SOC-Lectura,OU=Grupos,DC=acme,DC=local

# ------------------------------------------------------------ Asistente de investigación con IA (v10)
# Recomendado para datos del gobierno: modelo LOCAL (Ollama / vLLM) → los datos no salen de la red.
#   Ollama:  AI_PROVIDER=ollama   AI_BASE_URL=http://10.10.10.101:11434/v1   AI_MODEL=qwen2.5:14b
#   vLLM / compatible OpenAI:  AI_PROVIDER=openai  AI_BASE_URL=http://servidor:8000/v1  AI_MODEL=...  (AI_API_KEY si lo pide)
#   Claude (nube):  AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...  AI_MODEL=<id del modelo>
# El modelo debe soportar herramientas (function calling). Sin estas variables el asistente queda desactivado.
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# Modelo para el verificador independiente (vacío = el mismo)
AI_VERIFY_MODEL=
# Pasos máximos de herramientas por pregunta y tiempo de espera por llamada (s)
AI_MAX_STEPS=8
AI_TIMEOUT=120
# En proveedores en la nube, enmascara los correos antes de enviarlos
AI_REDACT_PII=true

# ---------- Sophos Central (opcional) ----------
# Sophos Central → Configuración global → Credenciales de API → «Service Principal Super Admin»
# (para aislar/bloquear; con «Read-Only» solo se ven alertas y equipos). El secreto se muestra una sola vez.
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
# Solo si la credencial es de partner u organización: el tenant que se gestiona
SOPHOS_TENANT_ID=
# true si la credencial es «Service Principal ReadOnly»: el portal oculta aislar/escanear/bloquear
SOPHOS_READ_ONLY=false
# Cada cuántos minutos se consultan alertas (Sophos no envía webhooks)
SOPHOS_POLL_MIN=5
# Abrir incidente automático con alertas de esta severidad o más (high, medium, low; vacío = no)
SOPHOS_AUTO_INCIDENT=high
# true: la contención (aislar, bloquear) la debe aprobar una persona distinta de quien la pide
SOPHOS_FOUR_EYES=false
# Etiqueta de los sitios web bloqueados; la política de Control web debe tenerla en «Bloquear»
SOPHOS_WEB_TAG=SOC-ACME-BLOQUEO

# ---------- Auditoría ----------
# Días que se conserva la auditoría de cambios (data/audit.db). 0 = para siempre. Recomendado ≥ 730 en el sector público.
AUDIT_DAYS=730

# ---------- Informes de Pentera ----------
# Tamaño máximo del informe (PDF/JSON/CSV). Los originales se guardan en data/reports/
PENTERA_MAX_MB=50

# ---------- Monitor de portales ----------
# Comprobaciones simultáneas (con ~500 portales cada 15 min, 16 es suficiente)
MONITOR_PARALLEL=16

# ---------- Incidentes ----------
# false (recomendado): las detecciones (portales, Sophos, 365, IoC, Shuffle) solo PROPONEN; un analista confirma
# cada incidente en Incidentes → «Sugerencias de incidente». true: se crean solos como antes.
AUTO_INCIDENTS=false

# ---------- Microsoft 365 (opcional) — ver docs/m365.md ----------
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_READ_ONLY=false
M365_FOUR_EYES=false
M365_POLL_MIN=5
M365_SUGGEST_SEVERITY=high
M365_HOME_COUNTRY=DO
M365_RULES_SCAN_USERS=300

# ---------- Capturas y comparación visual de portales (contenedor soc-screens) ----------
# Token compartido entre soc-bridge y soc-screens. Genéralo con:  openssl rand -hex 24
# Sin token no se hacen capturas (el resto del monitor sigue funcionando).
SCREENS_TOKEN=
# Cada cuántas horas se captura cada portal (los marcados como «críticos» van primero)
SCREENS_INTERVAL_H=6
# Navegadores simultáneos (cada uno ~250 MB de RAM)
SCREENS_PARALLEL=3
# % de la página que cambió para marcar «cambio» y «sospecha»
VISUAL_CHANGE_PCT=30
VISUAL_ALERT_PCT=60
# Cada cuántos minutos se comprueba la huella (sha256) de los .js/.css propios de cada portal
INTEGRITY_INTERVAL_MIN=60

# ---------- Exposición / Shadow IT — ver docs/exposicion.md ----------
# El alcance (dominios, rangos de IP públicas) y la autorización se configuran en el portal: Exposición › Alcance.
# Solo para laboratorio: permite rangos privados (10.x, 192.168.x). En producción déjalo vacío.
EXPOSURE_ALLOW_PRIVATE=
# Fuentes del descubrimiento pasivo (normalmente no se tocan)
# EXPOSURE_CRTSH_URL=https://crt.sh
# EXPOSURE_INTERNETDB_URL=https://internetdb.shodan.io
