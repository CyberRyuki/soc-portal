<!-- Reglas para eventos generados por custom-misp.py -->
<group name="misp,threat_intel,">
  <rule id="100620" level="3">
    <decoded_as>json</decoded_as>
    <field name="integration">misp</field>
    <description>MISP: evento de integración</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100621" level="5">
    <if_sid>100620</if_sid>
    <field name="misp.error">\.+</field>
    <description>MISP: error al consultar la API ($(misp.value))</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100622" level="12">
    <if_sid>100620</if_sid>
    <field name="misp.found">1</field>
    <description>MISP: IoC conocido $(misp.value) [$(misp.type)] - evento $(misp.event_id): $(misp.event_info)</description>
    <options>no_full_log</options>
    <mitre><id>T1071</id></mitre>
  </rule>
</group>
